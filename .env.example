# ==============================================================================
# RAG Notification Dispatch Daemon (rag-notification-dispatch-daemon)
# 12-Factor Environment Configuration Template
# Reference Architecture: 5-Layer Production-Grade Backend Architecture
# Architectural Specifications: ADR-001 through ADR-005 & .ai/doc-api.md Section 6
# ==============================================================================
# Usage:
#   Copy this file to .env and adjust values for your local development or deployment:
#     cp .env.example .env
#
# Security Note:
#   .env is excluded by .gitignore and must NEVER be committed to version control.
#   Only commit template placeholders in .env.example.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & MEMORY BOUNDS (Go 1.23+ Runtime Ceiling)
# ------------------------------------------------------------------------------
# Go runtime soft memory limit inside 2GiB container ceiling (prevents OOM kills).
# Supported formats: 1800MiB, 2GiB, 1000MB, or raw byte count.
GOMEMLIMIT=1800MiB

# Go runtime garbage collection target percentage (default: 80).
# Set to 'off' or -1 to disable GC, or an integer target like 80 or 100.
GOGC=80

# ------------------------------------------------------------------------------
# 2. DAEMON IDENTITY & HTTP/SSE TRANSPORT
# ------------------------------------------------------------------------------
# Unique daemon instance identifier for pod-targeted routing (pod.{node_id}.events).
# Defaults to container hostname if unset.
NODE_ID=node-local-01

# HTTP/2 SSE and REST API listening port. Default: 8080.
HTTP_PORT=8080

# Alternate port fallback (compatible with Cloud Run / PaaS container runners).
PORT=8080

# ------------------------------------------------------------------------------
# 3. POSTGRESQL PERSISTENCE (Cold-Path & Notification Journaling via PgBouncer)
# ------------------------------------------------------------------------------
# PgBouncer connection DSN for tenant subscriptions and event replay journal.
# STRICT INVARIANT: Cold-path only; never accessed on live CDC event dispatch path.
# Credentials are automatically redacted as "[REDACTED]" in all structured logs.
POSTGRES_DSN=postgres://rag_user:rag_password@localhost:5432/rag_notifications?sslmode=disable

# ------------------------------------------------------------------------------
# 4. REDIS 7.2 CLUSTER & TARGETED POD BACKPLANE
# ------------------------------------------------------------------------------
# Comma-separated list of Redis 7.2 cluster node addresses.
REDIS_ADDRS=localhost:6379

# Redis cluster authentication secret (empty if authentication is disabled locally).
# Redacted as "[REDACTED]" in all structured logs.
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. APACHE KAFKA 3.7+ CDC OUTBOX CONSUMER
# ------------------------------------------------------------------------------
# Comma-separated list of Kafka bootstrap brokers for transactional CDC outbox.
KAFKA_BROKERS=localhost:9092

# Kafka consumer group identifier for daemon ingestion worker pool.
KAFKA_CONSUMER_GROUP=rag-notification-dispatch-daemon

# Comma-separated list of upstream CDC outbox topics to ingest.
KAFKA_CDC_TOPICS=rag.cdc.kb-catalog,rag.cdc.ingestion,rag.cdc.chunk-lifecycle

# ------------------------------------------------------------------------------
# 6. ASYNCHRONOUS WEBHOOK TASK ENQUEUEING (SSRF & EGRESS ISOLATION - ADR-001)
# ------------------------------------------------------------------------------
# Redis Stream or broker routing key for downstream rag-webhook-delivery-worker.
# STRICT INVARIANT: Outbound HTTP POST requests are never executed directly in this daemon.
WEBHOOK_QUEUE_STREAM=rag:webhook:tasks

# ------------------------------------------------------------------------------
# 7. HIGH-DENSITY SSE ENGINE & RING BUFFER TUNING (ADR-002)
# ------------------------------------------------------------------------------
# Per-client non-blocking ring buffer capacity (default: 256 frames).
# Overflows drop intermediate non-terminal events; terminal status is always preserved.
SSE_RING_BUFFER_SIZE=256

# Maximum continuous buffer saturation duration before client socket eviction.
SSE_SLOW_CONSUMER_TIMEOUT=5s

# Interval for flushed keepalive comment frames (: ping\n\n) to bypass edge proxies.
SSE_HEARTBEAT_INTERVAL=15s

# ------------------------------------------------------------------------------
# 8. STAGGERED GRACEFUL CONNECTION DRAINING (ADR-005)
# ------------------------------------------------------------------------------
# Minimum randomized socket closure jitter delay on SIGTERM (default: 30s).
DRAIN_JITTER_MIN=30s

# Maximum randomized socket closure jitter delay on SIGTERM (default: 60s).
# Must fit inside Kubernetes terminationGracePeriodSeconds (75s).
DRAIN_JITTER_MAX=60s

# ------------------------------------------------------------------------------
# 9. SECURITY, AUTHENTICATION & CHANNEL AUTHORIZATION
# ------------------------------------------------------------------------------
# RSA/ECDSA public key PEM string for verifying SSE channel bearer tokens.
# If left empty, simple bearer token verification is used in development.
JWT_PUBLIC_KEY_PEM=

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & SECURED LOGGING
# ------------------------------------------------------------------------------
# Structured log/slog logging threshold: DEBUG, INFO, WARN, or ERROR.
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 11. DOTENV RUNTIME CONTROL
# ------------------------------------------------------------------------------
# Optional custom path to .env file (default: searches .env in cwd and parent dirs).
# ENV_FILE=.env

# Whether values defined in .env override existing OS environment variables (true/false).
DOTENV_OVERRIDE=true

